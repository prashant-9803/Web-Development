generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AvatarVideoStatus {
  Pending
  Done
  Error
}

enum AvatarImageType {
  User
  Model
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String

  avatars      Avatar[]
  avatarVideos AvatarVideo[]
}

model Avatar {
  id     String @id @default(uuid())
  name   String
  userId String

  user                  User                   @relation(fields: [userId], references: [id])
  avatarImages          AvatarImage[]
  avatarVideoReferences AvatarVideoReference[]
}

model AvatarImage {
  id       String          @id @default(uuid())
  avatarId String
  types    AvatarImageType
  url      String

  avatar Avatar @relation(fields: [avatarId], references: [id])
}

model AvatarVideo {
  id         String            @id @default(uuid())
  userId     String
  prompt     String
  startFrame String?
  endFrame   String?
  duration   Int
  width      Int
  height     Int
  status     AvatarVideoStatus

  user                   User                   @relation(fields: [userId], references: [id])
  avatartVideoReferences AvatarVideoReference[]
}

model AvatarVideoReference {
  id            String @id @default(uuid())
  avatarVideoId String
  avatarId      String

  avatar      Avatar      @relation(fields: [avatarId], references: [id])
  avatarVideo AvatarVideo @relation(fields: [avatarVideoId], references: [id])
}
